# ── Frontend (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# 仅当 Dashboard 仍开启「Confirm email」时设为 true（会传 emailRedirectTo）
NEXT_PUBLIC_SUPABASE_CONFIRM_EMAIL=false

# 与 DEV_BYPASS_AUTH 同时开启：免登录进 /protected（调页面用，仅本地）
NEXT_PUBLIC_DEV_BYPASS_AUTH=true
DEV_BYPASS_AUTH=true

# 显示注册/登录页「开发工具」面板（默认 development 也会显示）
NEXT_PUBLIC_DEV_TOOLS=true

# 本地批量建测试号（不发邮件、绕过邮件限流）：
# SUPABASE_SERVICE_ROLE_KEY=...（Dashboard → Settings → API）
# SUPABASE_DB_PASSWORD=...（Dashboard → Settings → Database，scripts/ 直连用）
# GITHUB_TOKEN=...（Issue 报告自动 POST，可用 gh auth token）
# DEV_ALLOW_ADMIN_SIGNUP=true

# Supabase Dashboard（一次性配置）：
# 1. Authentication → Providers → Email → 关掉 Confirm email
# 2. Authentication → URL Configuration → Redirect URLs 加 http://localhost:3000/**
# 3. 若报邮件限流：Authentication → Rate Limits，或等冷却

# ── Backend API (backend/) — copy to backend/.env ──────────
PORT=4000
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-publishable-or-anon-key
OPENAI_API_KEY=sk-...
DEV_USER_ID=00000000-0000-0000-0000-000000000001
