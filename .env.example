# TalkFlow 环境变量模板
# 复制为 .env.local 并填入真实值。完整说明见本地 docs/CONFIG.md（docs/ 不入库）

# ── 生产必需（Vercel 也要配同名变量）────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
OPENAI_API_KEY=sk-...   # 仅 NEXT_PUBLIC_AI_PRACTICE=true 或搜索/onboarding 时需要

# ── 可选 · 功能 ─────────────────────────────────────────────
# 默认 /api/v1（同源）；一般不必设
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# 仅当 Supabase 仍开启 Confirm email 时设为 true
NEXT_PUBLIC_SUPABASE_CONFIRM_EMAIL=false

# Stripe（未配则 checkout 提示未开通）
# STRIPE_SECRET_KEY=sk_live_...

# 开口评分：默认浏览器免费模式（Web Speech 识别 + 本地比对）
# 设为 true 才走 OpenAI Whisper + GPT（按次计费）
# NEXT_PUBLIC_AI_PRACTICE=true
# OPENAI_BASE_URL=https://api.aihubcli.com/v1
# OPENAI_CHAT_MODEL=gpt-5.2
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_FILL_MODEL=gpt-4o-mini
# OPENAI_GRAMMAR_MODEL=gpt-5.2
# OPENAI_IMAGE_MODEL=gpt-image-1

# ── 仅本地开发（勿上 Vercel 生产）────────────────────────────
NEXT_PUBLIC_DEV_BYPASS_AUTH=true
DEV_BYPASS_AUTH=true
NEXT_PUBLIC_DEV_TOOLS=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# 解锁全部订阅关卡（客户端 + 服务端各一个）
# NEXT_PUBLIC_DEV_UNLOCK_ALL=true
# DEV_UNLOCK_ALL=true

# 批量建测试号：app/api/dev/create-user
# DEV_ALLOW_ADMIN_SIGNUP=true
# SUPABASE_SERVICE_ROLE_KEY=...

# ── 仅脚本（scripts/ 直连 DB / GitHub）──────────────────────
# DATABASE_URL=postgresql://...
# SUPABASE_DB_PASSWORD=...
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_ANON_KEY=...          # 部分脚本上传 Storage 用（同 publishable key）
# GITHUB_TOKEN=...               # 或 GH_TOKEN；Issue 自动评论
# LLM_BACKEND=openai             # 或 cursor-agent
# CURSOR_AGENT_MODEL=composer-2.5-fast

# Supabase Dashboard 一次性配置见 docs/CONFIG.md
