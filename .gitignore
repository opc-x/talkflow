# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# editor
.vscode/

# intermediate work artifacts (never commit)
.opc/

# dependencies
/node_modules
/backend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/backend/dist
/shared/**/*.js

# misc
.DS_Store
*.pem
.cursor/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local AI skills (local tooling, not project code)
.agents/
skills-lock.json

# Playwright MCP artifacts (generated by AI browser automation, never commit)
screenshot-*.png
.playwright-mcp/
.opc 

# agent/dev 临时产物(日志、截图、报告),不入库
.tmp/
tests/reports/
